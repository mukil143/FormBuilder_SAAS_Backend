// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum RazorpayStatus {
  created
  authenticated
  active
  pending
  halted
  cancelled
  completed
  expired
}

enum Role {
  ADMIN
  USER
}

enum FieldType {
  TEXT
  EMAIL
  NUMBER
  TEXTAREA
  DROPDOWN
  CHECKBOX
  RADIO
  DATE
}

enum ReportStatus {
  RISED
  INPROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}




model User {
  userId    String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())
  plan         PlanType @default(FREE)
  AccountStatus  AccountStatus @default(ACTIVE) // For admin to deactivate/reactivate accounts
  //reset password token and expiry
  resetToken        String? @unique
  resetTokenExpiry  DateTime?
  // Usage metrics
  formCount Int @default(0)
  // e.g., number of form responses submitted in the current month
  monthlyResponseCount Int @default(0)
  razorpayCustomerId   String?  @unique
  //-- Relations
  form         Form[]
  masterField  MasterField[]
  formResponse FormResponse[]
  userReport   UserReport[]
  apiKey       ApiKey[]

  //Subscription relation
  subscriptions  Subscription[]
}

model MasterField {
  masterFieldId String    @id @default(uuid())
  label          String
  type          FieldType
  options       Json? // for dropdown, checkbox, radio
  userId        String
  user          User      @relation(fields: [userId], references: [userId],onDelete: Cascade)

  formField FormField[]
}

model Form {
  formId      String   @id @default(uuid())
  title       String
  description String?
  slug        String   @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [userId],onDelete: Cascade)
  sharedUrl String?
  //-- Customization fields
  theme       Json? @default("{}") // e.g., colors, fonts
  formField    FormField[]
  formResponse FormResponse[]
}

model FormField {
  formFieldId String  @id @default(uuid())
  label       String
  required    Boolean @default(false)
  order       Int @default(0)
  type        FieldType
  options     Json? // for dropdown, checkbox, radio
  formId String
  form   Form   @relation(fields: [formId], references: [formId],onDelete: Cascade)

  masterFieldId String?
  masterField   MasterField?    @relation(fields: [masterFieldId], references: [masterFieldId],onDelete: SetNull)
  responseValue ResponseValue[]
}

model FormResponse {
  formResponseId String   @id @default(uuid())
  createdAt      DateTime @default(now())

  formId String
  form   Form   @relation(fields: [formId], references: [formId],onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [userId],onDelete: Cascade)

  responseValue ResponseValue[]
}

model ResponseValue {
  responseValueId String @id @default(uuid())
  value           Json?

  formResponseId String
  formResponse   FormResponse @relation(fields: [formResponseId], references: [formResponseId],onDelete: Cascade)

  formFieldId String
  formField   FormField @relation(fields: [formFieldId], references: [formFieldId] ,onDelete: Cascade)
}


model UserReport{
  reportId String @id @default(uuid())
  userId String
  reportData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status ReportStatus @default(RISED)
  user          User      @relation(fields: [userId], references: [userId],onDelete: Cascade)
}


model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique // The Public Key (e.g., pk_live_12345)
  secret    String   // The Hashed Secret Key (e.g., $2b$10$...)
  name      String?  // Label (e.g., "Production Website")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  userId    String
  user     User     @relation(fields: [userId], references: [userId],onDelete: Cascade)
}


model Subscription {
  subscriptionId String   @id @default(uuid())
  userId         String
  plan           PlanType @default(FREE)
  status         RazorpayStatus
  // For simplicity, we can store the start and end dates of the subscription in the database.
  startDate      DateTime @default(now())
  currentPeriodEnd     DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isActive       Boolean  @default(true)
  razorpaySubscriptionId String       @unique
  user           User     @relation(fields: [userId], references: [userId],onDelete: Cascade)
}



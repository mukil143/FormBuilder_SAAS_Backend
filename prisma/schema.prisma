// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}


enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum BillingPeriod {
  monthly
  yearly
}

enum RazorpayStatus {
  created
  authenticated
  active
  pending
  halted
  cancelled
  completed
  expired
}

enum Role {
  ADMIN
  USER
}

enum FieldType {
  TEXT
  EMAIL
  NUMBER
  TEXTAREA
  DROPDOWN
  CHECKBOX
  RADIO
  DATE
}

enum ReportStatus {
  RISED
  INPROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}




model User {
  userId    String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())
  AccountStatus  AccountStatus @default(ACTIVE) // For admin to deactivate/reactivate accounts
  //reset password token and expiry
  resetToken        String? @unique
  resetTokenExpiry  DateTime?
  // Usage metrics
  formCount Int @default(0)
  monthlyResponseCount Int @default(0)
  dailyResponseCount Int @default(0)
  teamSize Int @default(1)
  apiKeyCount Int @default(0)
 // For future team features
  // For Razorpay integration
  razorpayCustomerId   String?  @unique
  //-- Relations
  form         Form[]
  masterField  MasterField[]
  formResponse FormResponse[]
  userReport   UserReport[]
  apiKey       ApiKey[]

  //Subscription relation
  subscriptions  Subscription[]
}

model MasterField {
  masterFieldId String    @id @default(uuid())
  label          String
  type          FieldType
  options       Json? // for dropdown, checkbox, radio
  userId        String
  placeHolder     String?
  required        Boolean @default(false)
  readOnly        Boolean @default(false)
  user          User      @relation(fields: [userId], references: [userId],onDelete: Cascade)

  formField FormField[]
}

model Form {
  formId      String   @id @default(uuid())
  title       String
  description String?
  slug        String   @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [userId],onDelete: Cascade)
  sharedUrl String?
  //-- Customization fields
  theme       Json? @default("{}") // e.g., colors, fonts
  formField    FormField[]
  formResponse FormResponse[]
}

model FormField {
  formFieldId String  @id @default(uuid())
  label       String
  required    Boolean @default(false)
  order       Int @default(0)
  type        FieldType
  options     Json? // for dropdown, checkbox, radio
  formId String
  form   Form   @relation(fields: [formId], references: [formId],onDelete: Cascade)

  masterFieldId String?
  masterField   MasterField?    @relation(fields: [masterFieldId], references: [masterFieldId],onDelete: SetNull)
  responseValue ResponseValue[]
}

model FormResponse {
  formResponseId String   @id @default(uuid())
  createdAt      DateTime @default(now())

  formId String
  form   Form   @relation(fields: [formId], references: [formId],onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [userId],onDelete: Cascade)

  responseValue ResponseValue[]
}

model ResponseValue {
  responseValueId String @id @default(uuid())
  value           Json?

  formResponseId String
  formResponse   FormResponse @relation(fields: [formResponseId], references: [formResponseId],onDelete: Cascade)

  formFieldId String
  formField   FormField @relation(fields: [formFieldId], references: [formFieldId] ,onDelete: Cascade)
}


model UserReport{
  reportId String @id @default(uuid())
  userId String
  reportData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status ReportStatus @default(RISED)
  user          User      @relation(fields: [userId], references: [userId],onDelete: Cascade)
}


model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique // The Public Key (e.g., pk_live_12345)
  secret    String   // The Hashed Secret Key (e.g., $2b$10$...)
  name      String?  // Label (e.g., "Production Website")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  userId    String
  user     User     @relation(fields: [userId], references: [userId],onDelete: Cascade)
}


model Subscription {
  subscriptionId String   @id @default(uuid())
  userId         String
  planId         String

  status         RazorpayStatus

  startDate      DateTime @default(now())
  currentPeriodEnd DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  razorpaySubscriptionId String @unique

  user        User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  planDetails Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

// 1. Global Settings (For storing the Admin's Razorpay Keys)
model PlatformSetting {
  id                String   @id @default(uuid())
  razorpayKeyId     String?
  razorpayKeySecret String?
  razorpayWebhookSecret String?
  createdAt         DateTime @default(now())
 // This will still be encrypted!
  updatedAt         DateTime @updatedAt
}

// 2. The SaaS Subscription Plans
model Plan {
  id                String   @id @default(uuid())

  planType          String   // PRO, BUSINESS
  razorpayPlanId    String?   @unique

  name              String
  description       String?

  amount            Int      // in paise
  currency          String   @default("INR")

  period            BillingPeriod
  interval          Int      @default(1)

  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monthlyResponseLimit Int @default(0)
  dailyResponseLimit   Int @default(0)
  activeFormLimit      Int @default(0)
  apiKeyLimit          Int @default(0)
  userLimit            Int @default(0)
  themeAccess          Boolean @default(false)

  subscriptions Subscription[]

  @@unique([planType, period])
  @@index([planType])
}
